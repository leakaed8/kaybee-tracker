GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nabc...\n-----END PRIVATE KEY-----\n"
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
MANAGER_PASSCODE=choose-a-passcode-for-yourself
REP_PASSCODE=choose-a-passcode-for-your-rep
PORT=3001
# Server-side only — restricted to the Geocoding API. Used to turn a typed
# address into lat/lng for pharmacies/doctors when no GPS fix was captured.
GOOGLE_MAPS_SERVER_KEY=your-geocoding-api-key
# Training tab: video files live only in a private Cloudflare R2 bucket,
# never in this app. R2 API token needs Object Read & Write, scoped to just
# this bucket — never exposed to the client. CLOUDFLARE_ACCOUNT_ID is the
# same account ID shown in your Cloudflare dashboard URL.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
