GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nabc...\n-----END PRIVATE KEY-----\n"
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
MANAGER_PASSCODE=choose-a-passcode-for-yourself
REP_PASSCODE=choose-a-passcode-for-your-rep
PORT=3001
# Server-side only — restricted to the Geocoding API. Used to turn a typed
# address into lat/lng for pharmacies/doctors when no GPS fix was captured.
GOOGLE_MAPS_SERVER_KEY=your-geocoding-api-key
# Training tab: video files live only on Cloudflare Stream, never in this
# app. This token needs Stream:Edit permission (it enables signed-URL-only
# playback and mints short-lived playback tokens) — never exposed to the
# client.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token
