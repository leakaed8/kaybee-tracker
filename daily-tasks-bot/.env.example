# --- Telegram ---
# Token from @BotFather for @DailyTasks_LeaBot. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenDoNotCommitRealValue

# Your personal numeric Telegram user ID (not your @username).
# Leave this BLANK for initial setup: message the bot and it will reply
# with your numeric ID so you can copy it here. Once set, only this user
# id may use the bot.
ALLOWED_TELEGRAM_USER_ID=

# A long random string only you know. Used to (a) build the secret webhook
# URL path and (b) verify Telegram's request came from Telegram, not a
# random visitor. Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-a-long-random-string

# A second, separate long random string, used to authorize the daily 9:30 AM
# trigger (see /cron/daily?key=...). Generate with: openssl rand -hex 24
CRON_SECRET=change-me-to-a-different-long-random-string

# The public base URL of your deployed server, e.g. https://dailytasks-leabot.onrender.com
# (no trailing slash). Used only by the scripts/set-webhook helper.
PUBLIC_BASE_URL=

# --- Database (Google Sheets) ---
# Same values as kaybee-tracker's server/.env.example -- if this is deployed
# with the same Google Cloud service account, reuse the exact same
# GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY here. SHEET_ID can point
# at a brand new sheet, or the same sheet as kaybee-tracker -- either way
# this bot creates its own "Tasks" and "State" tabs automatically and never
# touches any other tab.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nabc...\n-----END PRIVATE KEY-----\n"
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Misc ---
PORT=3000
TIMEZONE=Asia/Beirut
